<Window x:Class="NEXLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEX Launcher" Width="520" Height="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#0B0F17" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="14">
        <Grid Margin="38">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" Background="#5B9DFF" CornerRadius="18" Margin="0,0,0,18">
                    <TextBlock Text="N" FontSize="40" FontWeight="Bold" Foreground="#0B0F17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NEX" FontSize="32" FontWeight="Bold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                <TextBlock Text="MINECRAFT LAUNCHER" FontSize="10" Foreground="#7D8B9E" Margin="0,7,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <ProgressBar Height="2" IsIndeterminate="True" Foreground="#5B9DFF" Background="#141C28" BorderThickness="0" />
                <TextBlock Text="正在准备工作区" Foreground="#7D8B9E" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
