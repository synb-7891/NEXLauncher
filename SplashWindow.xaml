<Window x:Class="NEXLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEX Launcher" Width="520" Height="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#F3F5F9" BorderBrush="#DDE4EE" BorderThickness="1" CornerRadius="14">
        <Grid Margin="38">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" Background="#5B9DFF" CornerRadius="18" Margin="0,0,0,18">
                    <TextBlock Text="N" FontSize="40" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NEX" FontSize="32" FontWeight="Bold" Foreground="#1B2A41" HorizontalAlignment="Center" />
                <TextBlock Text="MINECRAFT LAUNCHER" FontSize="10" Foreground="#8A97A8" Margin="0,7,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <ProgressBar Height="2" IsIndeterminate="True" Foreground="#4C9AFF" Background="#E4EAF3" BorderThickness="0" />
                <TextBlock Text="正在准备工作区" Foreground="#8A97A8" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
