<Window x:Class="NEXLauncher.OfflineLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线登录" Width="380" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#131B16" CornerRadius="12" BorderBrush="#29352C" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="离线账号" FontSize="16" FontWeight="SemiBold" Foreground="#F3F7F1" />
            <TextBlock Grid.Row="1" Text="输入游戏内昵称（3-16 位字母、数字或下划线）" FontSize="12"
                       Foreground="#9BA99F" Margin="0,10,0,8" />
            <TextBox x:Name="UsernameBox" Grid.Row="2" FontSize="14" Padding="10,8"
                     Background="#101713" Foreground="#F3F7F1" BorderBrush="#344538"
                     MaxLength="16" VerticalContentAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#B4C0B6" BorderThickness="0" Cursor="Hand" />
                <Button Content="进入游戏" Click="Confirm_Click" Padding="18,8"
                        Background="#9BE564" Foreground="#101713" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
