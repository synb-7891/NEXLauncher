<Window x:Class="NEXLauncher.ImportVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入本机游戏版本" Width="720" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#0B0F17" CornerRadius="14" BorderBrush="#1F2A3A" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <DockPanel Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="#7D8B9E" BorderThickness="0"
                        Cursor="Hand" FontSize="14" Click="Cancel_Click" VerticalAlignment="Top" />
                <TextBlock Text="导入本机已有游戏版本" FontSize="18" FontWeight="SemiBold" Foreground="#E6EDF3" />
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="TargetLabel" FontSize="12" Foreground="#7D8B9E"
                       Margin="0,6,0,14" TextWrapping="Wrap" />

            <!-- 工具栏 -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock x:Name="ScanStatus" DockPanel.Dock="Right" FontSize="11" Foreground="#7D8B9E"
                           VerticalAlignment="Center" Margin="10,0,0,0" Text="准备扫描…" />
                <Button x:Name="RescanBtn" Content="重新扫描" Padding="12,6" Margin="0,0,8,0"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="Rescan_Click" />
                <Button x:Name="BrowseBtn" Content="浏览其他目录…" Padding="12,6" Margin="0,0,8,0"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="Browse_Click" />
                <Button x:Name="SelectAllBtn" Content="全选" Padding="12,6"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="SelectAll_Click" />
            </DockPanel>

            <!-- 版本列表 -->
            <Border Grid.Row="3" Background="#0F1620" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                        <StackPanel x:Name="ListPanel" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" Text="没有找到可导入的版本" Foreground="#7D8B9E" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 导入方式 -->
            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <RadioButton x:Name="RadioCopy" GroupName="Mode" IsChecked="True" Foreground="#E6EDF3" FontSize="12"
                             Checked="Mode_Changed"
                             Content="复制导入（推荐）· 把版本复制到当前启动器，源目录删除也不受影响" />
                <RadioButton x:Name="RadioLink" GroupName="Mode" Foreground="#E6EDF3" FontSize="12"
                             Margin="0,6,0,0" Checked="Mode_Changed"
                             Content="链接导入 · 秒完成、不占空间，源目录被删除后该版本失效" />
                <CheckBox x:Name="WithLibsBox" Foreground="#C4D0E0" FontSize="12" Margin="22,8,0,0"
                          Content="同时补齐 libraries 与 assets（体积较大，可离线启动；不勾选则首次启动自动联网补全）" />
            </StackPanel>

            <!-- 进度 -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"
                             Background="#1A2436" Foreground="#5B9DFF" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#7D8B9E" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="取消" Width="90" Height="34" Margin="8,0,0,0"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click" />
                <Button x:Name="OkBtn" Content="导入所选" Width="110" Height="34" Margin="8,0,0,0"
                        Background="#5B9DFF" Foreground="#0B0F17" BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand" Click="Ok_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
