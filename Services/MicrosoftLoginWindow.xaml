<Window x:Class="NEXLauncher.Services.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NEX Launcher · 微软正版登录"
        Width="960" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False">
    <Border Background="#F3F5F9" BorderBrush="#DDE4EE" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 云白标题栏 -->
            <Border Grid.Row="0" Background="#F3F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="#4C9AFF" CornerRadius="7">
                            <TextBlock Text="N" FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="微软正版登录" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="#1B2A41" VerticalAlignment="Center" />
                        <TextBlock Text="使用你的 Microsoft / Minecraft 账号" FontSize="11" Margin="12,1,0,0"
                                   Foreground="#8A97A8" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMin" Click="BtnMin_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#6B7A90"
                                Content="&#xE921;" />
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#6B7A90"
                                Content="&#xE8BB;" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 登录页面 -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#F3F5F9" />
                <Border x:Name="LoadingMask" Background="#F3F5F9">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" Background="#4C9AFF" CornerRadius="14"
                                HorizontalAlignment="Center">
                            <TextBlock Text="N" FontSize="26" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="正在打开微软登录页面…" FontSize="13" Foreground="#5F7189"
                                   Margin="0,14,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="首次加载可能需要几秒钟" FontSize="11" Foreground="#9AA7B8"
                                   Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
