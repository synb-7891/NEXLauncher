<Window x:Class="NEXLauncher.DeviceCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软账号登录" Width="440" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#131B16" CornerRadius="12" BorderBrush="#29352C" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="微软账号登录" FontSize="16" FontWeight="SemiBold" Foreground="#F3F7F1" VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="3" Margin="14,0,0,0" VerticalAlignment="Center"
                             Foreground="#9BE564" Background="#263329" BorderThickness="0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,14,0,0" Foreground="#9BA99F" FontSize="12"
                       TextWrapping="Wrap" LineHeight="18"
                       Text="设备码登录：请在浏览器中打开微软设备登录页，输入下方代码完成登录。" />

            <Border Grid.Row="2" Background="#101713" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                    BorderBrush="#344538" BorderThickness="1">
                <TextBlock x:Name="CodeText" Foreground="#9BE564" FontSize="14" TextWrapping="Wrap"
                           LineHeight="22" Text="正在获取登录代码..." />
            </Border>

            <Button Grid.Row="3" Content="取消登录" Click="Cancel_Click" HorizontalAlignment="Right"
                    Padding="16,7" Margin="0,14,0,0" Background="Transparent"
                    Foreground="#B4C0B6" BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
