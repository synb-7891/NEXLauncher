<Window x:Class="NEXLauncher.ModloaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择模组加载器" Width="520" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#0B0F17" CornerRadius="14" BorderBrush="#1F2A3A" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="安装模组加载器" FontSize="18" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" x:Name="VersionLabel" FontSize="12" Foreground="#7D8B9E" Margin="0,0,0,14" />

            <StackPanel Grid.Row="2">
                <TextBlock Text="选择加载器（已显示各加载器最新版本）" Foreground="#7D8B9E" FontSize="11" Margin="0,0,0,8" />
                <RadioButton x:Name="RadioVanilla" GroupName="Loader" IsChecked="True" Checked="LoaderChoice_Changed"
                             Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,8"
                             Content="原版 · 不安装模组加载器，纯净游戏" />
                <RadioButton x:Name="RadioFabric" GroupName="Loader" Checked="LoaderChoice_Changed"
                             Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,8"
                             Content="Fabric · 正在获取最新版本..." />
                <RadioButton x:Name="RadioForge" GroupName="Loader" Checked="LoaderChoice_Changed"
                             Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,8"
                             Content="Forge · 正在获取最新版本..." />
                <RadioButton x:Name="RadioQuilt" GroupName="Loader" Checked="LoaderChoice_Changed"
                             Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,14"
                             Content="Quilt · 正在获取最新版本..." />

                <TextBlock x:Name="VanillaHint" Text="原版无需选择加载器版本，点击「安装」即可下载纯净游戏。"
                           Foreground="#7D8B9E" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="VersionSection">
                    <TextBlock Text="加载器版本（默认选中推荐版本，标注「最新 / 推荐」）：" Foreground="#7D8B9E" FontSize="11" Margin="0,0,0,6"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="VersionCombo" Height="34" Background="#141C28" Foreground="#E6EDF3"
                              BorderBrush="#1F2A3A" Padding="8,5" IsEnabled="False" />
                    <TextBlock x:Name="LoadingHint" Text="" Foreground="#7D8B9E" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelBtn" Content="取消" Width="90" Height="34" Margin="8,0,0,0"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                <Button x:Name="OkBtn" Content="安装" Width="90" Height="34" Margin="8,0,0,0"
                        Background="#5B9DFF" Foreground="#0B0F17" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Ok_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
