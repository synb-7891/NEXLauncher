<Window x:Class="NEXLauncher.AuthlibLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外置登录" Width="480" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#0B0F17" CornerRadius="14" BorderBrush="#1F2A3A" BorderThickness="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="外置登录（authlib-injector）" FontSize="18" FontWeight="SemiBold"
                       Foreground="#E6EDF3" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="支持 LittleSkin、Ely.by 等所有 Yggdrasil 外置认证服务器"
                       FontSize="12" Foreground="#7D8B9E" Margin="0,0,0,14" />

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="认证服务器 API 地址" Foreground="#7D8B9E" FontSize="11" Margin="0,0,0,6" />
                <ComboBox x:Name="ServerBox" Height="36" FontSize="13" IsEditable="True"
                          Background="#141C28" Foreground="#E6EDF3" BorderBrush="#1F2A3A" Padding="8,5">
                    <ComboBoxItem Content="https://littleskin.cn/api/yggdrasil" IsSelected="True" />
                    <ComboBoxItem Content="https://authserver.ely.by/api/authlib-injector" />
                </ComboBox>
                <TextBlock x:Name="ServerNameText" Text="" Foreground="#7D8B9E" FontSize="11" Margin="2,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="邮箱 / 用户名" Foreground="#7D8B9E" FontSize="11" Margin="0,0,0,6" />
                <TextBox x:Name="UserBox" Height="36" FontSize="13" Background="#141C28" Foreground="#E6EDF3"
                         BorderBrush="#1F2A3A" Padding="10,7" VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,6">
                <TextBlock Text="密码" Foreground="#7D8B9E" FontSize="11" Margin="0,0,0,6" />
                <PasswordBox x:Name="PassBox" Height="36" FontSize="13" Background="#141C28" Foreground="#E6EDF3"
                             BorderBrush="#1F2A3A" Padding="10,7" VerticalContentAlignment="Center" KeyDown="PassBox_KeyDown" />
            </StackPanel>

            <TextBlock Grid.Row="6" x:Name="StatusText" Text="" Foreground="#7D8B9E" FontSize="11" Margin="2,2,0,0"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="取消" Width="90" Height="34" Margin="8,0,0,0"
                        Background="#1A2436" Foreground="#C4D0E0" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                <Button x:Name="OkBtn" Content="登录" Width="90" Height="34" Margin="8,0,0,0"
                        Background="#5B9DFF" Foreground="#0B0F17" BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
